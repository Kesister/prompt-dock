{
  "name": "prompt-dock",
  "version": "0.11.0",
  "description": "本地优先的 Prompt 桌面启动器",
  "main": "main.js",
  "author": "Codex",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:slash": "node scripts/build-slash-helper.js",
    "build:focus": "node scripts/build-focus-grant.js",
    "test:slash": "node --test tests/slash-core.test.js",
    "test:preview": "node scripts/test-slash-preview.js",
    "dist": "npm run build:slash && npm run build:focus && electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.codex.promptdock",
    "productName": "Prompt Dock",
    "artifactName": "Prompt-Dock-${version}-portable.${ext}",
    "files": [
      "main.js",
      "author-links.js",
      "storage.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "slash-*.js",
      "slash.html",
      "slash.css",
      "assets/**/*",
      "!assets/author-wechat-qr.jpg",
      "package.json"
    ],
    "asarUnpack": [
      "assets/PromptDock.WinHelper.exe",
      "assets/PromptDock.SlashHelper.exe",
      "assets/PromptDock.FocusGrant.exe"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Prompt-Dock-${version}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prompt Dock",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  }
}
