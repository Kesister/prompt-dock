# Track only reviewed source and shipped assets. Local libraries/builds stay local.
/*
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/main.js
!/preload.js
!/renderer.js
!/storage.js
!/index.html
!/styles.css
!/README.md
!/MAC-HANDOFF.md
!/assets/
/assets/*
!/assets/app.ico
!/assets/logo.png
!/assets/author-avatar.jpg
!/assets/author-wechat-qr.jpg
!/assets/PromptDock.WinHelper.cs
!/assets/PromptDock.WinHelper.exe

!/scripts/
/scripts/*
!/scripts/build-mac.js
!/scripts/smoke-test.js
!/scripts/native-paste-target.swift
!/scripts/verify-backup.js
!/assets/PromptDock.MacHelper.swift
