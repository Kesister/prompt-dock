# Track only reviewed source and shipped assets. Local libraries/builds stay local.
/*
!/.gitignore
!/.gitattributes
!/package.json
!/package-lock.json
!/main.js
!/author-links.js
!/update-controller.js
!/update-renderer.js
!/.github/
!/preload.js
!/renderer.js
!/storage.js
!/index.html
!/styles.css
!/slash-*.js
!/slash.html
!/slash.css
!/scripts/
!/tests/
!/README.md
!/CONTRIBUTING.md
!/docs/
/docs/*
!/docs/index.html
!/docs/.nojekyll
!/docs/USER-GUIDE.md
!/docs/DEVELOPMENT.md
!/docs/NOTION-SKILL.md
!/docs/CHANGELOG.md
!/MAC-HANDOFF.md
!/assets/
/assets/*
!/assets/app.ico
!/assets/logo.png
!/assets/author-avatar.jpg
!/assets/PromptDock.WinHelper.cs
!/assets/PromptDock.WinHelper.exe
!/assets/PromptDock.SlashHelper.cs
!/assets/PromptDock.SlashHelper.exe
!/assets/PromptDock.FocusGrant.cs
!/assets/PromptDock.FocusGrant.exe

# Only the reviewed shareable skill source may enter version control; ZIP packages live in Releases.
!/skills/
/skills/*
!/skills/promptdock-notion-sync/
/skills/promptdock-notion-sync/*
!/skills/promptdock-notion-sync/SKILL.md
!/skills/promptdock-notion-sync/agents/
/skills/promptdock-notion-sync/agents/*
!/skills/promptdock-notion-sync/agents/openai.yaml
!/skills/promptdock-notion-sync/references/
/skills/promptdock-notion-sync/references/*
!/skills/promptdock-notion-sync/references/workflow.md
!/skills/promptdock-notion-sync/scripts/
/skills/promptdock-notion-sync/scripts/*
!/skills/promptdock-notion-sync/scripts/sync.py
!/skills/promptdock-notion-sync/scripts/test_sync.py

# Keep generated test captures and local diagnostic reports out of source control.
/tests/*.png
/tests/*.json
/tests/verification-beta.*.md
/tests/inspect-weixin.js
/tests/InspectInputSupport.cs
